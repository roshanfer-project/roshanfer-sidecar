deployment=chain3
sidecar=false
appSize=1
app2Size=1
SAMPLE_RATE=0
OTEL_ADDR=localhost:4317

appPreRepeat=0
appPostRepeat=50
backend1Repeat=300
backend2Repeat=300
node2Repeat=100
node3Repeat=300


backendBatch=false

appListenPort=2007

# App (S1) talks directly to S2 (3005)
Backend1AppEgress=localhost:3005

# S2 Listens on 3005
Backend1ListenPort=3005

Backend2ListenPort=3006

# S3 Listens on 3006
PORT_S3=3006
