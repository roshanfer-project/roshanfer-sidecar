deployment=chain3
sidecar=true
appSize=1
app2Size=1
SAMPLE_RATE=0
OTEL_ADDR=localhost:4317

appPreRepeat=0
appPostRepeat=50
backend1Repeat=300
backend2Repeat=300
node2Repeat=100
node3Repeat=300


backendBatch=false

appListenPort=2007

# App (S1) talks to its sidecar egress (4007) to reach S2
Backend1AppEgress=localhost:4007

# S2 Listen Port (Host)
Backend1ListenPort=2005

Backend2ListenPort=2006

# S3 Listen Port (Host) - Override for Node 3
PORT_S3=2006
